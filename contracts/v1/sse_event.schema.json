{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangeltech.net/contracts/kernel-harness/v1/sse_event.schema.json",
  "title": "SSE event v1 (`event:` carrega o tipo, `data:` o JSON)",
  "type": "object",
  "required": ["type", "data"],
  "properties": {
    "type": {"enum": ["token", "step", "agent", "artifact", "approval_required",
                      "skill_proposed", "usage", "limit", "done", "error"]},
    "data": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "token"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["text"],
       "properties": {"text": {"type": "string"}}}}}},
    {"if": {"properties": {"type": {"const": "step"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["kind", "label", "status"],
       "properties": {
         "kind": {"enum": ["skill", "tool", "plan", "queue", "wake"]},
         "label": {"type": "string", "minLength": 1},
         "status": {"enum": ["start", "done", "error"]},
         "position": {"type": "integer", "minimum": 0}}}}}},
    {"if": {"properties": {"type": {"const": "agent"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["name", "status"],
       "properties": {"name": {"type": "string"}, "status": {"enum": ["start", "done"]}}}}}},
    {"if": {"properties": {"type": {"const": "artifact"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["artifact_id", "kind", "title"],
       "properties": {"artifact_id": {"type": "string"}, "kind": {"type": "string"},
                      "title": {"type": "string"}}}}}},
    {"if": {"properties": {"type": {"const": "approval_required"}}},
     "then": {"properties": {"data": {"type": "object",
       "required": ["approval_id", "summary", "risk", "expires_at", "actions"],
       "properties": {"approval_id": {"type": "string"}, "summary": {"type": "string"},
                      "risk": {"enum": ["low", "medium", "high"]},
                      "expires_at": {"type": "string"},
                      "actions": {"type": "array", "items": {"enum": ["approve", "deny"]}}}}}}},
    {"if": {"properties": {"type": {"const": "skill_proposed"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["user_skill_id", "name", "status"],
       "properties": {"user_skill_id": {"type": "string"}, "name": {"type": "string"},
                      "status": {"type": "string"}}}}}},
    {"if": {"properties": {"type": {"const": "usage"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["input_tokens", "output_tokens"],
       "properties": {"input_tokens": {"type": "integer", "minimum": 0},
                      "output_tokens": {"type": "integer", "minimum": 0},
                      "cost_usd": {"type": ["number", "null"]},
                      "runtime": {"type": "object",
                                  "properties": {"provider": {"type": "string"}, "model": {"type": "string"}}}}}}}},
    {"if": {"properties": {"type": {"const": "limit"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["detail"],
       "properties": {"detail": {"type": "string"}}}}}},
    {"if": {"properties": {"type": {"const": "done"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["text"],
       "properties": {"text": {"type": "string", "minLength": 1}}}}}},
    {"if": {"properties": {"type": {"const": "error"}}},
     "then": {"properties": {"data": {"type": "object", "required": ["detail", "code"],
       "properties": {"detail": {"type": "string"},
                      "code": {"enum": ["timeout", "empty_answer", "interrupted", "cancelled",
                                        "failed", "partial_answer", "queue_expired", "tool_limit",
                                        "tenant_suspended", "kernel_restarted", "worker_unavailable",
                                        "busy", "invalid_request"]}}}}}}
  ]
}
